# FINANCE_CLAMD_ENGINE_SHA256=

# FINANCE_OCR_TESSERACT=/usr/bin/tesseract  # external CLEAN originals, requires approved worker isolation
# FINANCE_PDFINFO=/usr/bin/pdfinfo
# FINANCE_PDFTOPPM=/usr/bin/pdftoppm

# Synthetic fixture AI only. No external data or automatic verification.
FINANCE_AI_SYNTHETIC_ENABLED=0
