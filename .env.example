# Development only. Set a new local-only password; do not commit .env.
FINANCE_DEV_DB_PASSWORD=
FINANCE_BIND=127.0.0.1:8080

# Optional isolated worker adapter settings; do not enable on live data without approval.
# FINANCE_EXPORT_ARTIFACT_ROOT=/absolute/private/export-root
# FINANCE_EXPORT_SYNTHETIC_RECEIPTS_ONLY=1  # disposable tests only; never combine with artifact root
# FINANCE_OCR_SYNTHETIC_TESSERACT=/usr/bin/tesseract  # synthetic clean invoice PNGs only
# FINANCE_OCR_TESSDATA_DIR=/absolute/approved/vietnamese-traineddata-directory

# External storage: explicit opt-in only after provider/permissions approval.
# FINANCE_S3_ENABLED=0
# FINANCE_S3_ENDPOINT=
# FINANCE_S3_REGION=
# FINANCE_S3_ACCESS_KEY=
# FINANCE_S3_SECRET_KEY=
# FINANCE_S3_STAGING_BUCKET=
# FINANCE_S3_QUARANTINE_BUCKET=
