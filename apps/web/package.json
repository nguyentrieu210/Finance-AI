{
  "name": "finance-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "generate:api": "openapi-typescript ../../contracts/openapi.yaml -o src/generated/api.d.ts",
    "check:api": "openapi-typescript ../../contracts/openapi.yaml -o src/generated/api.d.ts --check"
  },
  "dependencies": {
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@types/react": "19.1.10",
    "@types/react-dom": "19.1.7",
    "openapi-typescript": "7.8.0",
    "typescript": "5.8.3",
    "vite": "6.3.6"
  }
}
