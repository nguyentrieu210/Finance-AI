{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:finance-ai:rule-dsl:2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "rule_id",
    "version",
    "condition",
    "severity",
    "waivable",
    "clause_id"
  ],
  "properties": {
    "rule_id": {
      "type": "string"
    },
    "version": {
      "type": "integer",
      "minimum": 1
    },
    "condition": {
      "$ref": "#/$defs/node"
    },
    "applicability": {
      "$ref": "#/$defs/node"
    },
    "severity": {
      "enum": [
        "BLOCK",
        "WARNING",
        "INFO"
      ]
    },
    "waivable": {
      "type": "boolean"
    },
    "clause_id": {
      "type": "string",
      "format": "uuid"
    }
  },
  "$defs": {
    "node": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "ref"
          ],
          "properties": {
            "ref": {
              "type": "string",
              "pattern": "^[a-zA-Z][a-zA-Z0-9_.]*$"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "literal",
            "value_type"
          ],
          "properties": {
            "literal": {
              "oneOf": [
                {
                  "type": "string"
                },
                {
                  "type": "boolean"
                },
                {
                  "type": "array",
                  "items": {
                    "type": "string"
                  },
                  "maxItems": 5000
                }
              ]
            },
            "value_type": {
              "enum": [
                "decimal",
                "money",
                "date",
                "string",
                "boolean",
                "enum",
                "set",
                "quantity"
              ]
            },
            "currency": {
              "type": "string",
              "pattern": "^[A-Z]{3}$"
            },
            "unit": {
              "type": "string"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "op",
            "args"
          ],
          "properties": {
            "op": {
              "enum": [
                "eq",
                "ne",
                "lt",
                "lte",
                "gt",
                "gte",
                "and",
                "or",
                "not",
                "exists",
                "in",
                "sum",
                "add",
                "sub",
                "mul",
                "div",
                "count",
                "all",
                "any",
                "date_diff"
              ]
            },
            "args": {
              "type": "array",
              "minItems": 1,
              "maxItems": 16,
              "items": {
                "$ref": "#/$defs/node"
              }
            },
            "binding": {
              "type": "string"
            }
          }
        }
      ]
    }
  }
}
